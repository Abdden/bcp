{
  "name": "secondattempt",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "babel src -d dist && npm run swagger-autogen",
    "dev": "better-npm-run dev",
    "start": "babel-node ./src/index.js",
    "swagger-autogen": "babel-node ./src/swagger.js",
    "test": "jest --testTimeout=20000 --detectOpenHandles --forceExit --collect-coverage && npm run coverage:ci",
    "coverage:ci": "if [ -n \"$COVERALLS_REPO_TOKEN\" ]; then coveralls < coverage/lcov.info; else echo 'Skipping Coveralls (COVERALLS_REPO_TOKEN not set)'; fi"
  },
  "betterScripts": {
    "dev": {
      "command": "nodemon --exec babel-node ./src/index.js"
    }
  },
  "keywords": [],
  "author": "Abdden",
  "license": "ISC",
  "dependencies": {
    "@babel/cli": "^7.19.3",
    "@babel/core": "^7.29.7",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-syntax-import-assertions": "^7.20.0",
    "@babel/plugin-transform-runtime": "^7.19.6",
    "@babel/preset-env": "^7.20.2",
    "@babel/register": "^7.18.9",
    "bcrypt": "^5.1.0",
    "better-npm-run": "^0.1.1",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.22.3",
    "http": "^0.0.1-security",
    "joi": "^17.13.6",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^6.13.10",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "multer-storage-cloudinary": "^4.0.0",
    "mz": "^2.7.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.0",
    "swagger-autogen": "^2.22.0",
    "swagger-jsdoc": "^6.2.7",
    "swagger-ui-express": "^4.1.2"
  },
  "devDependencies": {
    "@babel/node": "^7.20.5",
    "coveralls": "^3.1.1",
    "jest": "^29.3.1",
    "mongodb-memory-server": "^9.5.0",
    "nodemon": "^3.1.14",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": ["<rootDir>/src/test/env.js"],
    "setupFilesAfterEnv": ["<rootDir>/src/test/setup.js"]
  }
}
